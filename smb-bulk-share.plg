<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
PLUGIN_BOOT="/boot/config/plugins/smb-bulk-share"
PLUGIN_WEB="/usr/local/emhttp/plugins/smb-bulk-share"

mkdir -p "$PLUGIN_BOOT/backups"
chmod 0700 "$PLUGIN_BOOT/backups"

if [[ ! -f "$PLUGIN_BOOT/settings.cfg" ]]; then
  cp "$PLUGIN_WEB/default.cfg" "$PLUGIN_BOOT/settings.cfg"
  chmod 0644 "$PLUGIN_BOOT/settings.cfg"
fi

chmod 0755 "$PLUGIN_WEB/scripts/smb-bulk-share.php"
chmod 0644 "$PLUGIN_WEB/smb-bulk-share.page" "$PLUGIN_WEB/api.php" "$PLUGIN_WEB/icon.svg"
cp "$PLUGIN_WEB/smb-bulk-share.cron" "$PLUGIN_BOOT/smb-bulk-share.cron"
chmod 0644 "$PLUGIN_BOOT/smb-bulk-share.cron"
/usr/local/sbin/update_cron

echo ""
echo "-----------------------------------------------------------"
echo " SMB Bulk Share Control has been installed."
echo " Open Settings -> User Utilities -> SMB Bulk Share Control."
echo " Version: 2026.09.14"
echo "-----------------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
PLUGIN_BOOT="/boot/config/plugins/smb-bulk-share"

removepkg smb-bulk-share 2>/dev/null || true
find "$PLUGIN_BOOT" -maxdepth 1 -type f -name 'smb-bulk-share-*.txz' -delete
find "$PLUGIN_BOOT" -maxdepth 1 -type f -name '*.cron' -delete
/usr/local/sbin/update_cron

echo ""
echo "-----------------------------------------------------------"
echo " SMB Bulk Share Control has been removed."
echo " Settings and backups remain in $PLUGIN_BOOT."
echo "-----------------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

</PLUGIN>
